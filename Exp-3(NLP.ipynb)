      "source": [
        "\n",
        "import re\n",
        "\n",
        "text = \"Python is easy to learn. Contact us at 9876543210\"\n",
        "\n",
        "# Match a pattern at the beginning\n",
        "result1 = re.match(\"Python\", text)\n",
        "print(\"Match:\", result1.group() if result1 else \"Not Found\")\n",
        "\n",
        "# Search for a pattern anywhere in the text\n",
        "result2 = re.search(\"easy\", text)\n",
        "print(\"Search:\", result2.group() if result2 else \"Not Found\")\n",
        "\n",
        "# Find all numbers in the text\n",
        "result3 = re.findall(r\"\\d+\", text)\n",
        "print(\"Find All:\", result3)\n",
        "\n",
        "# Check whether a pattern exists\n",
        "result4 = re.search(r\"\\d{10}\", text)\n",
        "print(\"Mobile Number:\", result4.group() if result4 else \"Not Found\")\n"
      ]
    },
