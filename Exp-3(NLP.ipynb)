        "import nltk\n",
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "ps = PorterStemmer()\n",
        "\n",
        "words = [\"playing\", \"played\", \"plays\", \"running\", \"studies\"]\n",
        "\n",
        "for word in words:\n",
        "    print(word, \"->\", ps.stem(word))\n"
